generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Problem {
  id               Int       @id @default(autoincrement())
  title            String
  link             String?
  topic            String
  pattern          String?
  difficulty       String
  sourceList       String?
  status           String    @default("Unsolved") // Unsolved, Solved, Struggled
  stage            Int       @default(0) // Spaced repetition stage
  nextRevisionDate DateTime?
  triggerNote      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  revisionLogs   RevisionLog[]
  mistakeEntries MistakeEntry[]
}

model RevisionLog {
  id        Int      @id @default(autoincrement())
  problemId Int
  date      DateTime @default(now())
  outcome   String // Recalled, Forgot

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model MistakeEntry {
  id          Int      @id @default(autoincrement())
  problemId   Int
  date        DateTime @default(now())
  category    String // Misread Constraints, Wrong Pattern, etc.
  description String
  lesson      String?

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model ConceptNote {
  id           Int      @id @default(autoincrement())
  patternTopic String   @unique
  coreIdea     String
  template     String?
  pitfalls     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
