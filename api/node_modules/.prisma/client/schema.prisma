generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  problems     Problem[]
  conceptNotes ConceptNote[]
  mistakes     MistakeEntry[]
}

model Problem {
  id     Int @id @default(autoincrement())
  userId Int

  title String
  link  String?

  topic   String
  pattern String?

  difficulty String
  sourceList String?

  problemStatement String?
  exampleInput     String?
  exampleOutput    String?
  constraints      String?
  solutionNotes    String?

  status String @default("UNSOLVED") // UNSOLVED, DUE, IN_PROGRESS, MASTERED
  stage  Int    @default(0) // 0-3 = active revision, 4 = mastered

  firstSolvedAt    DateTime?
  nextRevisionDate DateTime?
  lastRevisionDate DateTime?
  masteredAt       DateTime?
  lastOutcome      String?

  triggerNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  attempts       Attempt[]
  revisionLogs   RevisionLog[]
  mistakeEntries MistakeEntry[]
}

model Attempt {
  id        Int @id @default(autoincrement())
  problemId Int

  date    DateTime @default(now())
  outcome String // SOLVED, STRUGGLED

  timeTaken Int? // in seconds
  approach  String?

  thoughts   String? // user's thinking/approach notes
  complexity String? // time & space complexity analysis
  code       String? // pseudo code, java, etc.

  triggerNote String?
  notes       String?

  createdAt DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model RevisionLog {
  id        Int @id @default(autoincrement())
  problemId Int

  scheduledDate DateTime?
  completedDate DateTime  @default(now())

  stageBefore Int
  stageAfter  Int

  outcome          String // RECALLED, FORGOT
  assessment       String?
  recallTime       Int?
  thoughts         String?
  code             String?
  approach         String?
  timeComplexity   String?
  spaceComplexity  String?
  complexityReason String?

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model ConceptNote {
  id     Int @id @default(autoincrement())
  userId Int

  pattern String
  topic   String

  coreIdea String
  template String?

  variations String?
  pitfalls   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MistakeEntry {
  id        Int @id @default(autoincrement())
  userId    Int
  problemId Int

  date DateTime @default(now())

  category    String // MISREAD_CONSTRAINTS, WRONG_PATTERN, EDGE_CASE, IMPLEMENTATION_BUG, TIME_MANAGEMENT, UNKNOWN_CONCEPT
  description String
  lesson      String?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}
